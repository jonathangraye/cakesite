---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatGBP, toPence } from '../lib/catalog';
import { DIETARY_LABELS } from '../lib/menu-options';

interface Props {
  item: CollectionEntry<'menu'>;
}

const { item } = Astro.props;
const d = item.data;
const prices = d.variants.map((v) => toPence(v.price));
const min = Math.min(...prices);
const priceLabel = prices.length > 1 ? `From ${formatGBP(min)}` : formatGBP(min);
---

<article class="card">
  <a href={`/menu/${item.id}/`} class="card-link">
    <div class="card-media">
      <Image src={d.image} alt={d.imageAlt} width={640} class="card-image" />
      {!d.available && <span class="card-flag">Unavailable</span>}
    </div>
    <div class="card-body">
      <h3>{d.name}</h3>
      <p class="card-summary">{d.summary}</p>
      <p class="card-meta">
        <span class="price">{d.available ? priceLabel : 'Currently unavailable'}</span>
        {d.dietary.length > 0 && <span class="card-diet">{d.dietary.map((x) => DIETARY_LABELS[x]).join(' · ')}</span>}
      </p>
    </div>
  </a>
</article>
