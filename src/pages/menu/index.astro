---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES, CATEGORY_LABELS } from '../../lib/menu-options';

const items = (await getCollection('menu')).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder || a.data.name.localeCompare(b.data.name),
);
const groups = CATEGORIES.map((c) => ({
  id: c,
  label: CATEGORY_LABELS[c],
  items: items.filter((i) => i.data.category === c),
})).filter((g) => g.items.length > 0);
---

<Base title="Menu" description="Our full menu of plant-based cakes, cookies and bakes.">
  <header class="page-head">
    <p class="eyebrow">Our menu</p>
    <h1>Everything we bake</h1>
    <p class="lead">Every item is 100% plant-based and baked to order for your delivery date.</p>
    {
      groups.length > 1 && (
        <nav class="pills" aria-label="Menu sections">
          {groups.map((g) => (
            <a href={`#${g.id}`}>{g.label}</a>
          ))}
        </nav>
      )
    }
  </header>
  {
    groups.map((g) => (
      <section class="menu-group" id={g.id} aria-labelledby={`${g.id}-title`}>
        <h2 id={`${g.id}-title`} class="group-title">
          {g.label} <span class="group-count">{g.items.length}</span>
        </h2>
        <div class="grid">
          {g.items.map((item) => (
            <ProductCard item={item} />
          ))}
        </div>
      </section>
    ))
  }
</Base>
