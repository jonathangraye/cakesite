---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { site } from '../site';
import rules from '../data/delivery.json';
import { deliveryDaysSentence } from '../lib/order-rules';

const items = (await getCollection('menu', (i) => i.data.available)).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder || a.data.name.localeCompare(b.data.name),
);
const featured = items.filter((i) => i.data.featured);
const shown = (featured.length > 0 ? featured : items).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>Plant-based bakes, made to order</h1>
    <p class="lead">{site.tagline}</p>
    <a class="button" href="/menu/">See the menu</a>
  </section>

  {
    shown.length > 0 && (
      <section>
        <h2>Customer favourites</h2>
        <div class="grid">
          {shown.map((item) => (
            <ProductCard item={item} />
          ))}
        </div>
      </section>
    )
  }

  <section class="steps">
    <h2>How ordering works</h2>
    <ol>
      <li><strong>Choose your bakes</strong> from the menu and add them to your basket.</li>
      <li><strong>Check your postcode</strong> and pick a preferred delivery date.</li>
      <li><strong>Pay securely</strong> with Stripe. Your receipt arrives by email.</li>
    </ol>
    <p>{deliveryDaysSentence(rules)} <a href="/delivery/">Delivery areas and fees</a>.</p>
  </section>
</Base>
